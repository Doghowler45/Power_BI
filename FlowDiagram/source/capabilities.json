{
    "dataRoles": [
        {
            "displayName": "Stages",
            "description": "Two to four fields, left to right: for example segment, channel, market",
            "name": "levels",
            "kind": "Grouping"
        },
        {
            "displayName": "Values",
            "description": "The measure that sets the width of each flow",
            "name": "value",
            "kind": "Measure"
        }
    ],
    "objects": {
        "layout": {
            "properties": {
                "nodeWidth": {
                    "type": {
                        "numeric": true
                    }
                },
                "nodeGap": {
                    "type": {
                        "numeric": true
                    }
                },
                "maxNodes": {
                    "type": {
                        "numeric": true
                    }
                }
            }
        },
        "colours": {
            "properties": {
                "source": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "builtIn",
                                "displayName": "Built-in (colour-blind safe)"
                            },
                            {
                                "value": "theme",
                                "displayName": "Report theme"
                            }
                        ]
                    }
                },
                "by": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "first",
                                "displayName": "First stage"
                            },
                            {
                                "value": "last",
                                "displayName": "Last stage"
                            }
                        ]
                    }
                }
            }
        },
        "labels": {
            "properties": {
                "values": {
                    "type": {
                        "bool": true
                    }
                },
                "fontSize": {
                    "type": {
                        "numeric": true
                    }
                },
                "units": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "auto",
                                "displayName": "Auto"
                            },
                            {
                                "value": "none",
                                "displayName": "None"
                            },
                            {
                                "value": "thousands",
                                "displayName": "Thousands"
                            },
                            {
                                "value": "millions",
                                "displayName": "Millions"
                            },
                            {
                                "value": "billions",
                                "displayName": "Billions"
                            }
                        ]
                    }
                },
                "decimals": {
                    "type": {
                        "numeric": true
                    }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "levels": {
                        "min": 0,
                        "max": 4
                    },
                    "value": {
                        "max": 1
                    }
                }
            ],
            "table": {
                "rows": {
                    "select": [
                        {
                            "for": {
                                "in": "levels"
                            }
                        },
                        {
                            "bind": {
                                "to": "value"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 5000
                        }
                    }
                }
            }
        }
    ],
    "sorting": {
        "default": {}
    },
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        }
    },
    "supportsLandingPage": true,
    "supportsEmptyDataView": true,
    "privileges": []
}
