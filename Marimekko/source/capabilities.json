{
    "dataRoles": [
        {
            "displayName": "Columns",
            "description": "One column for each value; its width shows its size",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "Segments",
            "description": "What each column is split into",
            "name": "series",
            "kind": "Grouping"
        },
        {
            "displayName": "Values",
            "description": "The measure, such as revenue",
            "name": "value",
            "kind": "Measure"
        },
        {
            "displayName": "Tooltips",
            "description": "Optional. More measures to show on hover",
            "name": "tooltips",
            "kind": "Measure"
        }
    ],
    "objects": {
        "layout": {
            "properties": {
                "sortColumns": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "total",
                                "displayName": "Largest first"
                            },
                            {
                                "value": "none",
                                "displayName": "Data order"
                            }
                        ]
                    }
                },
                "maxSegments": {
                    "type": {
                        "numeric": true
                    }
                },
                "maxColumns": {
                    "type": {
                        "numeric": true
                    }
                },
                "gap": {
                    "type": {
                        "numeric": true
                    }
                }
            }
        },
        "colours": {
            "properties": {
                "source": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "builtIn",
                                "displayName": "Built-in (colour-blind safe)"
                            },
                            {
                                "value": "theme",
                                "displayName": "Report theme"
                            }
                        ]
                    }
                }
            }
        },
        "labels": {
            "properties": {
                "show": {
                    "type": {
                        "bool": true
                    }
                },
                "content": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "share",
                                "displayName": "Share of column"
                            },
                            {
                                "value": "value",
                                "displayName": "Value"
                            }
                        ]
                    }
                },
                "fontSize": {
                    "type": {
                        "numeric": true
                    }
                },
                "units": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "auto",
                                "displayName": "Auto"
                            },
                            {
                                "value": "none",
                                "displayName": "None"
                            },
                            {
                                "value": "thousands",
                                "displayName": "Thousands"
                            },
                            {
                                "value": "millions",
                                "displayName": "Millions"
                            },
                            {
                                "value": "billions",
                                "displayName": "Billions"
                            }
                        ]
                    }
                },
                "decimals": {
                    "type": {
                        "numeric": true
                    }
                }
            }
        },
        "legend": {
            "properties": {
                "show": {
                    "type": {
                        "bool": true
                    }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": {
                        "max": 1
                    },
                    "series": {
                        "max": 1
                    },
                    "value": {
                        "max": 1
                    },
                    "tooltips": {
                        "max": 5
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "category"
                    },
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 100
                        }
                    }
                },
                "values": {
                    "group": {
                        "by": "series",
                        "select": [
                            {
                                "bind": {
                                    "to": "value"
                                }
                            },
                            {
                                "for": {
                                    "in": "tooltips"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 60
                            }
                        }
                    }
                }
            }
        }
    ],
    "sorting": {
        "default": {}
    },
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        }
    },
    "supportsLandingPage": true,
    "supportsEmptyDataView": true,
    "privileges": []
}
